# Copy this file to .env and fill it in.

SECRET_KEY=change-me-to-any-long-random-text
DEBUG=True

# A SEPARATE Gmail just for outreach — not your personal one.
GMAIL_ADDRESS=nexlab.outreach@gmail.com
# Google Account > Security > 2-Step Verification > App passwords (16 letters)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# claude_cli = use your Claude Code login (Pro/Max subscription, no API bill)
# api        = use ANTHROPIC_API_KEY instead (pay per use)
LLM_BACKEND=claude_cli
# If Windows can't find `claude`, put the full path here, e.g.
# CLAUDE_BIN=C:\Users\HPBV\AppData\Roaming\npm\claude.cmd
CLAUDE_BIN=claude
# Optional model override, e.g. claude-sonnet-5-5
LLM_MODEL=
# ANTHROPIC_API_KEY=

AGENT_INTERVAL_MINUTES=15
